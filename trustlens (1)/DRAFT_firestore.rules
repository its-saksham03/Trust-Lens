rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.1 Connection Test
    match /test/connection {
      allow read: if true; // Publicly readable for status checks
    }

    // --- PHASE 3: Primitives ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- PHASE 4: Entity Validators ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'language', 'notificationEnabled', 'createdAt'])
        && data.keys().size() == 6
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() > 0
        && data.name is string && data.name.size() > 0
        && data.language in ['en', 'hi']
        && data.notificationEnabled is bool
        && data.createdAt is string; // Simplified for draft
    }

    function isValidUserApp(data) {
      return data.keys().hasAll(['packageName', 'installedAt', 'isAnalyzed', 'currentScore'])
        && data.keys().size() == 4
        && data.packageName is string && data.packageName.size() > 0
        && data.installedAt is string
        && data.isAnalyzed is bool
        && data.currentScore is number;
    }

    function isValidScan(data) {
      return data.userId == request.auth.uid 
        && data.packageName is string
        && data.summary is string
        && data.timestamp is string;
    }

    // --- MATCH BLOCKS ---

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'language', 'notificationEnabled']);
      
      match /installed_apps/{packageName} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidUserApp(incoming()) && isValidId(packageName);
        allow update: if isOwner(userId) && isValidUserApp(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly(['isAnalyzed', 'currentScore']);
      }
    }

    match /apps/{packageName} {
      allow read: if isSignedIn();
      allow list: if isSignedIn() && isValidId(packageName);
      // Writes are restricted (system only)
    }

    match /scans/{scanId} {
      allow create: if isSignedIn() && isValidScan(incoming()) && isValidId(scanId);
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
